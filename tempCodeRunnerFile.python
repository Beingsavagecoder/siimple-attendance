import math
from collections import Counter

# Entropy
def entropy(y):
    total = len(y)
    ans = 0
    counts = Counter(y)

    for c in counts.values():
        p = c / total
        ans -= p * math.log2(p)

    return ans


# Information Gain
def info_gain(data, labels, feature):
    total_entropy = entropy(labels)

    values = set(row[feature] for row in data)

    rem_entropy = 0

    for v in values:
        sub_labels = []

        for i in range(len(data)):
            if data[i][feature] == v:
                sub_labels.append(labels[i])

        rem_entropy += (len(sub_labels)/len(labels)) * entropy(sub_labels)

    return total_entropy - rem_entropy


# ID3
def id3(data, labels, features):

    if len(set(labels)) == 1:
        return labels[0]

    if len(features) == 0:
        return Counter(labels).most_common(1)[0][0]

    gains = [info_gain(data, labels, i) for i in range(len(features))]
    best = gains.index(max(gains))

    tree = {features[best]: {}}

    values = set(row[best] for row in data)

    for v in values:
        new_data = []
        new_labels = []

        for i in range(len(data)):
            if data[i][best] == v:
                new_data.append(data[i][:best] + data[i][best+1:])
                new_labels.append(labels[i])

        new_features = features[:best] + features[best+1:]

        tree[features[best]][v] = id3(new_data, new_labels, new_features)

    return tree


# Dataset
features = ["Outlook","Temp","Humidity","Wind"]

data = [
    ["Sunny","Hot","High","Weak"],
    ["Sunny","Hot","High","Strong"],
    ["Overcast","Hot","High","Weak"],
    ["Rain","Mild","High","Weak"],
    ["Rain","Cool","Normal","Weak"],
    ["Rain","Cool","Normal","Strong"],
    ["Overcast","Cool","Normal","Strong"]
]

labels = ["No","No","Yes","Yes","Yes","No","Yes"]

tree = id3(data, labels, features)

print(tree)